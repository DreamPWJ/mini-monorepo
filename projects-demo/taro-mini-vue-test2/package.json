{
  "name": "taro-mini-vue-test2",
  "version": "1.0.0",
  "private": true,
  "description": " Taro-V4 Webpack5",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "Sass",
    "framework": "Vue3"
  },
  "scripts": {
    "dev:weapp": "pnpm run -r compile:ts && npm run build:weapp -- --watch",
    "pnpm:reInstall": "rimraf node_modules && rimraf dist && rimraf .swc && pnpm install",
    "clean:modules": "rimraf node_modules && rimraf dist && rimraf .swc",
    "dev:swan": "npm run build:swan -- --watch",
    "dev:alipay": "npm run build:alipay -- --watch",
    "dev:tt": "npm run build:tt -- --watch",
    "dev:h5": "npm run build:h5 -- --watch",
    "dev:rn": "npm run build:rn -- --watch",
    "dev:qq": "npm run build:qq -- --watch",
    "dev:jd": "npm run build:jd -- --watch",
    "dev:harmony-hybrid": "npm run build:harmony-hybrid -- --watch",
    "build:weapp": "taro build --type weapp",
    "build:swan": "taro build --type swan",
    "build:alipay": "taro build --type alipay",
    "build:tt": "taro build --type tt",
    "build:h5": "taro build --type h5",
    "build:rn": "taro build --type rn",
    "build:qq": "taro build --type qq",
    "build:jd": "taro build --type jd",
    "build:harmony-hybrid": "taro build --type harmony-hybrid"
  },
  "browserslist": [
    "defaults and fully supports es6-module",
    "maintained node versions"
  ],
  "author": "",
  "dependencies": {
    "athena-common": "workspace:*",
    "athena-common-mini": "workspace:*",
    "athena-components-vue": "workspace:*",
    "athena-constants": "workspace:*",
    "athena-core": "workspace:*",
    "athena-styles": "workspace:*",
    "athena-test": "workspace:*",
    "athena-utils": "workspace:*",
    "@babel/runtime": "^7.24.4",
    "@tarojs/components": "4.0.3",
    "@tarojs/helper": "4.0.3",
    "@tarojs/plugin-platform-weapp": "4.0.3",
    "@tarojs/plugin-platform-alipay": "4.0.3",
    "@tarojs/plugin-platform-tt": "4.0.3",
    "@tarojs/plugin-platform-swan": "4.0.3",
    "@tarojs/plugin-platform-jd": "4.0.3",
    "@tarojs/plugin-platform-qq": "4.0.3",
    "@tarojs/plugin-platform-h5": "4.0.3",
    "@tarojs/plugin-platform-harmony-hybrid": "4.0.3",
    "@tarojs/runtime": "4.0.3",
    "@tarojs/shared": "4.0.3",
    "@tarojs/taro": "4.0.3",
    "@tarojs/plugin-framework-vue3": "4.0.3",
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@tarojs/cli": "4.0.3",
    "@babel/plugin-proposal-class-properties": "7.14.5",
    "@types/webpack-env": "^1.13.6",
    "webpack": "5.91.0",
    "@tarojs/taro-loader": "4.0.3",
    "@tarojs/webpack5-runner": "4.0.3",
    "sass": "^1.75.0",
    "babel-preset-taro": "4.0.3",
    "css-loader": "^7.1.1",
    "style-loader": "^3.3.4",
    "@tarojs/test-utils-vue3": "^0.1.1",
    "@vue/babel-plugin-jsx": "^1.2.2",
    "@vue/compiler-sfc": "^3.0.0",
    "vue-loader": "^17.4.2",
    "eslint-plugin-vue": "^9.17.0",
    "eslint-config-taro": "4.0.3",
    "eslint": "^8.57.0",
    "stylelint": "^16.4.0",
    "typescript": "^5.4.5",
    "tsconfig-paths-webpack-plugin": "^4.1.0",
    "postcss": "^8.4.38",
    "@types/node": "^18"
  }
}

