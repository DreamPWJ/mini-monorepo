{
  "name": "root",
  "private": true,
  "version": "1.0.0",
  "workspaces": {
    "packages": [
      "packages/*",
      "projects/*",
      "projects-demo/*"
    ],
    "nohoist": [
      "**/vant",
      "**/vant/**"
    ]
  },
  "scripts": {
    "bootstrap:all": "pnpm install && npm run build:all",
    "build:all": "pnpm run -r compile:ts && npm run gulp",
    "build:ts": "pnpm run -r compile:ts",
    "gulp": "cd scripts && gulp",
    "gulp:watch": "cd scripts && gulp watch",
    "packages:dev": "tsc -b packages/athena-components --watch",
    "clean:all": "npm run clean:modules && npm run clean:ts",
    "clean:modules": "rimraf node_modules && pnpm run -r clean:modules",
    "clean:ts": "pnpm run -r clean:ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@types/node": "^20.14.9",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.14.1",
    "danger": "^12.3.3",
    "dotenv-cli": "^7.4.2",
    "eslint": "^9.6.0",
    "gulp": "^5.0.0",
    "gulp-sass": "^5.1.0",
    "gulp-typescript": "^5.0.1",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.7",
    "prettier": "^3.3.2",
    "rimraf": "^5.0.7",
    "stylelint": "^16.6.1",
    "stylelint-config-standard": "^36.0.1",
    "typescript": "^5.5.2",
    "yargs": "^17.7.2"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,json,vue,ts,tsx}": [
      "eslint --fix",
      "prettier --write",
      "git add"
    ],
    "*.{css,scss,less}": [
      "stylelint --config  ./.stylelintrc --fix",
      "git add"
    ]
  },
  "husky": {
    "hooks": {}
  }
}
